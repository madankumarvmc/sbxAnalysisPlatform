# Environment Variables for Warehouse Analysis Tool

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Set specific model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: Configure LLM parameters
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_TOKENS=2048

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your-gemini-api-key-here' with your actual API key
# 3. Restart the application

# Note: Never commit your actual .env file with real API keys to version control